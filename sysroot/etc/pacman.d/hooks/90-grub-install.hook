[Trigger]
Type = Package
Operation = Upgrade
Target = grub

[Action]
Description = Reinstalling grub to the ESP and regenerating grub.cfg...
When = PostTransaction
Exec = /bin/sh -c '/usr/bin/grub-install --target=x86_64-efi --efi-directory=/efi --boot-directory=/boot --bootloader-id=arch && /usr/bin/grub-mkconfig -o /boot/grub/grub.cfg'
