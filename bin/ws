#! /bin/bash

# ws [-C DIR] [CLAUDE-ARG...] - without -C, ranger picks the directory.

case "$1" in
  -h | --help)
    cat <<'EOF'
Usage: ws [-C DIR] [CLAUDE-ARG...]

Open a new myxterm running claude in a new tmux session, named by the
lowest free number. Without -C, ranger picks the directory.
EOF
    exit
    ;;
esac

exec env -u TMUX myxterm bash -c '
mkdir -p ~/eph
n=0
while tmux has-session -t "=$n" 2>/dev/null; do n=$((n + 1)); done
if [ "$1" = -C ]; then
  dir="$2"
  shift 2
else
  tmp_file="$(mktemp)"
  ranger --choosedir="$tmp_file" ~/eph
  dir="$(cat "$tmp_file")"
  rm -f "$tmp_file"
fi
cd "$dir" || exit
tmux new-session -s "$n" "$(printf "%q " claude "$@"); exec bash"
' ws "$@"
