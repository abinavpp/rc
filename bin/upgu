#! /bin/bash

# systemd user units get a minimal PATH, without cargo and pipx shims.
PATH=$PATH:$HOME/.cargo/bin:$HOME/.local/bin

# opt <probe> <cmd...>: run cmd iff probe exists
opt() { command -v "$1" >/dev/null || return 0; shift; "$@"; }

~/.vim/stp

opt gh gh extension upgrade --all
opt pipx pipx upgrade-all
opt cargo-install-update cargo install-update -a
opt npm npm update -g
