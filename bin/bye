#! /bin/bash

# Prepare for shutdown: close every vim, warn about anything still running
# (unsaved vims, pacman, builds, agents), and offer a snapshot for hi.

ok=1
block() { ok=0; sed 's/^/[halt] /' <<< "$*"; }
warn() { ok=0; sed 's/^/[warn] /' <<< "$*"; }

# workspace name of wmctrl desktop index $1
ws_name() { wmctrl -d | awk -v d="$1" '$1 == d {print $NF; exit}'; }

# argv of pid $1, tab-separated so an argument may hold spaces.
argv_of() {
  local a
  a=$(tr '\0' '\t' < "/proc/$1/cmdline" 2>/dev/null | sed 's/\t$//')
  case $a in
    *$'\t'*) printf '%s\n' "$a" ;;
    *' '*) tr ' ' '\t' <<< "$a" ;;
    *) printf '%s\n' "$a" ;;
  esac
}

# tmux session the xterm $1 is attached to, '-' for a bare shell.
xterm_session() {
  local tty
  tty=$(ps --ppid "$1" -o tty= 2>/dev/null | head -1 | tr -d ' ')
  [ "$tty" ] && [ "$tty" != '?' ] || { echo -; return; }
  tmux -L default list-clients -F '#{client_tty} #{session_name}' 2>/dev/null |
    awk -v t="/dev/$tty" '$1 == t {print $2; exit}' |
    { read -r s; echo "${s:--}"; }
}

# "<session>:<window>.<pane> <cwd>" per claude, located by tty.
claude_panes() {
  local pid tty
  for pid in $(pgrep -x claude); do
    tty=$(ps -o tty= -p "$pid" | tr -d ' ')
    [ "$tty" ] && [ "$tty" != '?' ] || continue
    tmux -L default list-panes -a \
      -F '#{pane_tty} #{session_name}:#{window_index}.#{pane_index} #{pane_current_path}' \
      2>/dev/null | awk -v t="/dev/$tty" '$1 == t { print $2, $3 }'
  done
}

# newest transcript under cwd $1 that no earlier pane has claimed in file $2
transcript() {
  local f id
  for f in $(ls -t ~/.claude/projects/"${1//\//-}"/*.jsonl 2>/dev/null); do
    id=$(basename "$f" .jsonl)
    grep -qxF "$id" "$2" && continue
    echo "$id" >> "$2"
    echo "$id"
    return 0
  done
  return 1
}

# Three layers for hi: the windows and the workspace each sits on, the tmux tree
# behind the terminals, and what to run inside it - claude only.
snapshot() {
  local out=~/.local/state/session-restore tmp claimed
  tmp=$(mktemp) claimed=$(mktemp)

  # layer 1 - windows: workspace, class, then the tmux session an xterm hosts
  # ('-' for a bare shell) or the argv that brings anything else back
  wmctrl -lpx | while read -r _ desk pid class _; do
    class=${class##*.}
    if [ "$class" = XTerm ]; then
      printf 'win\t%s\tXTerm\t%s\n' "$(ws_name "$desk")" "$(xterm_session "$pid")"
    else
      printf 'win\t%s\t%s\t%s\n' "$(ws_name "$desk")" "$class" "$(argv_of "$pid")"
    fi
  done >> "$tmp"

  # layer 2 - the tmux tree those terminals attach to
  tmux -L default list-panes -a \
    -F 'tmux	#{session_name}	#{window_index}	#{pane_current_path}' \
    2>/dev/null >> "$tmp"

  # layer 3 - what runs inside a tmux window
  claude_panes | while read -r label cwd; do
    win=${label#*:}
    id=$(transcript "$cwd" "$claimed") || continue
    printf 'run\t%s\t%s\tclaude --resume %s\n' "${label%%:*}" "${win%%.*}" "$id"
  done >> "$tmp"

  mv "$tmp" "$out"
  rm -f "$claimed"
}

# tmux pane of a tty if tmux is up, the bare tty otherwise.
locate() {
  local tty=${1,,} pane
  pane=$(tmux -L default list-panes -a \
    -F '#{pane_tty} #{session_name}:#{window_index}.#{pane_index}' \
    2>/dev/null | awk -v t="$tty" '$1 == t {print "tmux "$2}')
  echo "${pane:-$tty}"
}

# "comm in <location>" per process matching $1, deduped, skipping any whose argv
# matches $2.
report() {
  local pid comm tty
  for pid in $(pgrep -x "$1"); do
    [[ -n ${2:-} ]] &&
      tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q -- "$2" && continue
    read -r comm tty <<< "$(ps -o comm=,tty= -p "$pid")"
    [[ -z $comm ]] && continue
    if [[ $tty == '?' ]]; then
      echo "$comm (no tty)"
    else
      echo "$comm in $(locate "/dev/$tty")"
    fi
  done | sort -u
}

if [[ -e /var/lib/pacman/db.lck ]] || pgrep -x 'pacman|yay' > /dev/null; then
  block "pacman/yay active"
fi

servers=$(vim --serverlist 2>/dev/null)
for s in $servers; do
  vim --servername "$s" --remote-send '<C-\><C-N>:qa<CR>' 2>/dev/null
done
for _ in {1..15}; do
  servers=$(vim --serverlist 2>/dev/null)
  [[ -z $servers ]] && break
  sleep 0.2
done

expr='join(map(filter(range(1,bufnr("$")),
  "getbufvar(v:val,'\''&modified'\'')"),
  "empty(bufname(v:val))?'\''[No Name]'\'':bufname(v:val)"), ",")'
for s in $servers; do
  mod=$(timeout 2 vim --servername "$s" --remote-expr "$expr" 2>/dev/null)
  block "vim in $(locate "$s") unsaved: ${mod:-unresponsive}"
done

for pid in $(pgrep -x vim); do
  tty=$(ps -o tty= -p "$pid" | tr -d ' ')
  [[ -z $tty ]] && continue
  [[ $tty == '?' ]] && { block "vim without tty, unchecked"; continue; }
  grep -qix "/dev/$tty" <<< "$servers" ||
    block "vim in $(locate "/dev/$tty") unchecked (no server)"
done

jobs=$(report 'ninja|cargo|rustc|make|cc1.*|rsync')
[[ -n $jobs ]] && warn "$jobs"

agents=$(report 'claude|codex' '--remote-control')
[[ -n $agents ]] && warn "$agents"

if [[ -t 0 ]]; then
  read -r -p "save snapshot? [y/N] " reply
  [[ $reply == y ]] && snapshot
fi

((ok)) && echo bye
exit $((!ok))
