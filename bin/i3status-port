#! /bin/bash

hp=$'\U1F3A7\UFE0E'
sp=$'\U1F568'

pidf="${XDG_RUNTIME_DIR:-/tmp}/scrrec.pid"
rec='{"name":"scrrec","markup":"none","color":"#d70000","full_text":"● REC"}'
vol='(.*"name":"volume"[^}]*"full_text":")(.*)'

i3status | while IFS= read -r line; do
  if pactl list sinks 2>/dev/null | grep -q 'Active Port:.*headphone'; then
    p=$hp
  else
    p=$sp
  fi
  if [[ $line =~ $vol ]]; then
    line="${BASH_REMATCH[1]}$p ${BASH_REMATCH[2]}"
  fi

  if kill -0 "$(cat "$pidf" 2>/dev/null)" 2>/dev/null && [[ $line == *'}]' ]]; then
    line="${line%]},$rec]"
  fi
  printf '%s\n' "$line"
done
